{
  "expo": {
    "name": "Vulcatic",
    "slug": "vulcatic",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vulcatic.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D84300",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vulcatic.app",
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Vulcatic needs access to your photos so you can share them.",
          "cameraPermission": "Vulcatic needs your camera so you can take photos to share."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFF7F2",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#121418"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vulcatic uses your location to show vulcanizing shops near you."
        }
      ]
    ],
    "scheme": "vulcatic",
    "backgroundColor": "#F7F5F3"
  }
}
