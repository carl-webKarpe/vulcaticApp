# Copy this file to .env and fill in the values from
# Supabase Dashboard → Project Settings → API.
# The anon key is meant to be public; your data is protected by the Row Level Security rules
# in supabase/migrations/0001_init.sql. NEVER put the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
